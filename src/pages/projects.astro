---
import Layout from "../layouts/Layout.astro";
import SectionTitle from "../components/SectionTitle.astro";

let projects = [];
let githubUnavailable = false;

try {
  const response = await fetch(
    "https://api.github.com/users/rovshangurbanov/repos?type=owner&sort=updated&per_page=100",
    {
      headers: {
        Accept: "application/vnd.github+json",
        "User-Agent": "rovshangurbanov-personal-site",
      },
    },
  );

  if (!response.ok) throw new Error(`GitHub API returned ${response.status}`);
  const repositories = await response.json();
  projects = Array.isArray(repositories)
    ? repositories.filter((repository) => repository.visibility === "public" && !repository.private)
    : [];
} catch (error) {
  console.warn("Could not load public GitHub repositories:", error);
  githubUnavailable = true;
}
---

  <Layout title="Projects Rovshan Gurbanov" description="Public GitHub repositories and projects by Rovshan Gurbanov.">
  <section class="page-hero">
    <span class="eyebrow">PROJECTS</span>
    <h1>Things I've built.</h1>
    <p>
      Projects from my public GitHub repositories, kept up to date automatically. 🛠️
    </p>
  </section>

  <section class="section compact-section">
    <SectionTitle
      title="Project archive"
    />

    <div class="project-list-large">
      {projects.map((project, index) => (
        <article class="project-large">
          <div class="project-large-number">{String(index + 1).padStart(2, "0")}</div>
          <div class="project-large-body">
            <h2>{project.name}</h2>
            <p>{project.description || "No description provided."}</p>
            <div class="chip-row">
              {[...new Set([project.language, ...(project.topics || [])].filter(Boolean))].map((tag) => <span>{tag}</span>)}
            </div>
          </div>
          <a class="circle-link" href={project.html_url} target="_blank" rel="noreferrer" aria-label={`Open ${project.name} on GitHub`}>↗</a>
        </article>
      ))}
      {projects.length === 0 && (
        <p class="project-empty">
          {githubUnavailable ? "Public GitHub projects are temporarily unavailable." : "There are no public repositories to show yet."}
        </p>
      )}
    </div>
  </section>
</Layout>
